# Keep this file free of real credentials. Copy to .env on the server.
HOST=127.0.0.1
PORT=8787
# Comma-separated individually issued access tokens (32+ random characters each).
IMPORT_ACCESS_TOKENS=
AI_PROVIDER_ORDER=gemini,anthropic
GEMINI_API_KEY=
GEMINI_MODEL=
# Enable direct public YouTube video input for a compatible Gemini model.
ENABLE_YOUTUBE_VIDEO=true
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
